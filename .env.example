# PostgreSQL used for the public download counter
DATABASE_URL=postgresql://ort_user:YOUR_PASSWORD@localhost:5432/ort_db

# Put your public itch.io game/download URL here.
# The shared URL is used as a fallback for all platforms.
ITCHIO_GAME_URL=https://YOUR-ITCH-USERNAME.itch.io/culinary-showdown

# Optional: override with platform-specific URLs if you have them.
ITCHIO_WINDOWS_URL=
ITCHIO_LINUX_URL=
ITCHIO_MACOS_URL=

# Set this to disable SSL when PostgreSQL is running locally on the same VPS.
PGSSL=disable
